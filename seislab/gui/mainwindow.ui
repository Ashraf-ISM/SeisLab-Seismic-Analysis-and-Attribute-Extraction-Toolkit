  <property name="styleSheet">
   <string notr="true">
* {
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 12px;
    color: #222222;
}
QMainWindow, QWidget { background-color: #ececec; }
QMenuBar, QStatusBar {
    background-color: #f4f4f4;
    border: 1px solid #c7c7c7;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #c7c7c7;
}
QToolBar {
    background-color: #f8f8f8;
    border: 1px solid #c7c7c7;
}
QTabWidget::pane, QTreeWidget, QTableWidget {
    background: #ffffff;
    border: 1px solid #c9c9c9;
}
QTabBar::tab {
    background: #e4e4e4;
    border: 1px solid #bdbdbd;
    padding: 6px 12px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #ffffff;
    border-bottom-color: #ffffff;
}
QGroupBox {
    border: 1px solid #bdbdbd;
    border-radius: 3px;
    margin-top: 10px;
    padding-top: 10px;
    background: #f8f8f8;
    font-weight: 700;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #404040;
}
QSpinBox, QDoubleSpinBox, QComboBox, QLineEdit {
    background: #ffffff;
    border: 1px solid #b8b8b8;
    border-radius: 3px;
    padding: 4px;
}
QPushButton {
    background-color: #d9e5ef;
    border: 1px solid #94adc5;
    border-radius: 2px;
    padding: 6px 10px;
    font-weight: 700;
    color: #1e3a50;
}
QPushButton:hover { background-color: #c7ddf0; }
QPushButton:disabled {
    background-color: #ebebeb;
    border: 1px solid #d1d1d1;
    color: #989898;
}
QSlider::groove:horizontal { height: 4px; background: #c2c2c2; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #1477ba;
    border: 2px solid #1477ba;
    width: 14px; height: 14px;
    margin: -5px 0; border-radius: 7px;
}
QSlider::sub-page:horizontal { background: #1477ba; border-radius: 2px; }
QCheckBox::indicator, QRadioButton::indicator { background: #ffffff; border: 1px solid #9a9a9a; }
QHeaderView::section {
    background: #efefef;
    color: #555555;
    border: 1px solid #d0d0d0;
    padding: 4px;
}
QSplitter::handle { background: #c7c7c7; }
QLabel#section_label { color: #666666; }
QLabel#value_label { color: #2e7d32; font-family: &quot;Consolas&quot;, &quot;Courier New&quot;, monospace; }
QLabel#coords_label { color: #ef6c00; font-family: &quot;Consolas&quot;, &quot;Courier New&quot;, monospace; }
